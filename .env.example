# Optional overrides for the Beyond dashboard data source.
# The current POC has safe publishable defaults in src/services/supabaseRest.ts.
# For production, configure these in Vercel Environment Variables.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"

# Optional new rolling24/48/72 public feed; empty means unavailable.
# The dedicated /rolling72-preview route explicitly uses a timestamped research snapshot.
VITE_ROLLING72_FEED_URL=
