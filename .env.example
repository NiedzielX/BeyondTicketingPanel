# Optional overrides for the Beyond dashboard data source.
# The current POC has safe publishable defaults in src/services/supabaseRest.ts.
# For production, configure these in Vercel Environment Variables.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"

# Optional read-only daily-path research export. Default: /research/daily-inventory-path-v1.json
# Public model outputs only; do not put service-role keys in a VITE_* variable.
# VITE_DAILY_INVENTORY_PATH_URL="/research/daily-inventory-path-v1.json"
